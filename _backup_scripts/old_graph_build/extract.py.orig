"""实体 + 超边 + head_entity 抽取。

一次 LLM 调用同时产出实体与超边；每条超边额外标注 head_entity（该事实的主语/主角），
用于检索时的「答案指向」匹配。

图按题缓存到 CACHE_DIR：缓存 key = 抽取 prompt + 问题 + 上下文 的 sha1，因此
改抽取 prompt 会自动失效旧缓存，不会用到脏图。
"""

import hashlib
import json
import os
import re
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed

import numpy as np

from common.llm import chat as llm_chat, embed_batch, phase, split_by_tokens
from config import (EXTRACT_CHUNK_TOKENS, EXTRACT_CHUNK_OVERLAP, EMBED_BATCH_SIZE,
                     CACHE_DIR, EMBED_MODEL, CHAT_MODEL, EXTRACT_WORKERS, EXTRACT_VERSION)

EXTRACT_SYSTEM = """You are a knowledge extraction expert. Extract entities and facts from the given text. The downstream task is short-answer QA (answers are 1-5 words).

## Entity Types

Classify each entity:
- Person: individuals, groups, roles
- Location: city, country, building, region, venue
- Organization: company, team, institution, band
- Event: war, election, release, discovery
- Concept: field, genre, theory, law
- Work: book, film, album, artwork

Time (dates, years) goes in time_span field, NOT as a separate entity.

## Hyperedges

One hyperedge = one atomic fact. A few sentences usually contain 1-3 facts — extract them all.

Self-contained principle:
- Each summary must be a complete sentence understandable alone
- Use full names: "Barack Obama" not just "Obama"
- Include time and location in the summary

## Output Format

Return ONLY valid JSON:
{
  "entities": [
    {
      "local_id": "E1",
      "name": "full entity name",
      "aliases": [],
      "type": "Person|Location|Organization|Event|Concept|Work",
      "description": "brief description",
      "time_span": "",
      "region_names": []
    }
  ],
  "hyperedges": [
    {
      "summary": "self-contained complete sentence",
      "entity_ids": ["E1", "E2"],
      "head_entity": "E1",
      "time_span": "",
      "region_names": []
    }
  ]
}

## Rules
1. local_id: E1, E2... incrementing
2. entity_ids must reference listed local_ids
3. Summaries must be self-contained with full names
4. Do NOT fabricate facts
5. Return empty arrays if no extractable facts in this text
6. Extract EVERY atomic fact in the text — do not stop early. A few sentences often contain multiple facts; capture all of them, including short factual statements (dates, single-clause facts).
7. Each hyperedge: 1-4 entity_ids
8. time_span: dates/years/periods mentioned in this fact (e.g., "1755", "19th century")
9. region_names: locations/places mentioned in this fact (e.g., ["Moscow", "Russia"])
10. If the text uses an abbreviation (e.g., "MSU"), add it as an alias for the full entity name (e.g., aliases: ["MSU"])
11. head_entity: the local_id of the entity that plays the SUBJECT / main-actor role in this fact (who/what the fact is about).

## Examples

Example 1
Title: Moscow State University
Text: Lomonosov Moscow State University (MSU) is a public research university in Moscow, Russia. It was founded in 1755 by Mikhail Lomonosov. It was renamed after Lomonosov in 1940.
Output:
{
  "entities": [
    {"local_id": "E1", "name": "Lomonosov Moscow State University", "aliases": ["MSU"], "type": "Organization", "description": "A public research university in Moscow, Russia, founded in 1755.", "time_span": "1755", "region_names": ["Moscow", "Russia"]},
    {"local_id": "E2", "name": "Moscow", "aliases": [], "type": "Location", "description": "Capital city of Russia.", "time_span": "", "region_names": ["Russia"]},
    {"local_id": "E3", "name": "Mikhail Lomonosov", "aliases": ["Lomonosov"], "type": "Person", "description": "Founder of Moscow State University.", "time_span": "", "region_names": []}
  ],
  "hyperedges": [
    {"summary": "Lomonosov Moscow State University is a public research university located in Moscow, Russia.", "entity_ids": ["E1", "E2"], "head_entity": "E1", "time_span": "", "region_names": ["Moscow", "Russia"]},
    {"summary": "Lomonosov Moscow State University was founded in 1755 by Mikhail Lomonosov.", "entity_ids": ["E1", "E3"], "head_entity": "E1", "time_span": "1755", "region_names": []},
    {"summary": "Lomonosov Moscow State University was renamed after Mikhail Lomonosov in 1940.", "entity_ids": ["E1", "E3"], "head_entity": "E1", "time_span": "1940", "region_names": []}
  ]
}

Example 2 (note: short fact-bearing sentences must also be extracted; use full names, never pronouns)
Title: Ed Wood
Text: Ed Wood is a 1994 American biographical film directed by Tim Burton. It stars Johnny Depp. The film won two Academy Awards.
Output:
{
  "entities": [
    {"local_id": "E1", "name": "Ed Wood", "aliases": [], "type": "Work", "description": "A 1994 American biographical film directed by Tim Burton.", "time_span": "1994", "region_names": []},
    {"local_id": "E2", "name": "Tim Burton", "aliases": [], "type": "Person", "description": "Director of the film Ed Wood.", "time_span": "", "region_names": []},
    {"local_id": "E3", "name": "Johnny Depp", "aliases": [], "type": "Person", "description": "Actor who starred in Ed Wood.", "time_span": "", "region_names": []},
    {"local_id": "E4", "name": "Academy Awards", "aliases": ["Oscars"], "type": "Event", "description": "Film awards won by Ed Wood.", "time_span": "", "region_names": []}
  ],
  "hyperedges": [
    {"summary": "Ed Wood is a 1994 American biographical film directed by Tim Burton.", "entity_ids": ["E1", "E2"], "head_entity": "E1", "time_span": "1994", "region_names": []},
    {"summary": "The film Ed Wood stars Johnny Depp.", "entity_ids": ["E1", "E3"], "head_entity": "E1", "time_span": "", "region_names": []},
    {"summary": "The film Ed Wood won two Academy Awards.", "entity_ids": ["E1", "E4"], "head_entity": "E1", "time_span": "", "region_names": []}
  ]
}"""


def make_id(prefix: str, seed: str) -> str:
    return prefix + hashlib.sha1(seed.encode("utf-8")).hexdigest()[:10]


def norm(s: str) -> str:
    return s.strip().lower()


def _coerce_str(x) -> str:
    """LLM 可能返回 str 也可能返回 list（如多个年份），统一压成 str 落盘。"""
    if isinstance(x, str):
        return x
    if isinstance(x, (list, tuple)):
        return " ".join(str(i) for i in x)
    return str(x) if x else ""


def split_sentences(text: str) -> list[str]:
    sents = re.split(r"(?<=[.!?])\s+", text.strip())
    return [s.strip() for s in sents if s.strip()]


def _infer_head(he: dict, entities_by_id: dict, name_of: dict):
    """head_entity 缺失时的启发式：summary 中最早出现的实体。"""
    summary = he.get("summary", "").lower()
    best, best_pos = None, None
    for eid in he.get("entity_ids", []):
        if eid not in entities_by_id:
            continue
        name = entities_by_id[eid]["name"].lower()
        pos = summary.find(name)
        if pos < 0:
            for a in entities_by_id[eid].get("aliases", []):
                pos = summary.find(a.lower())
                if pos >= 0:
                    break
        if pos >= 0 and (best_pos is None or pos < best_pos):
            best, best_pos = eid, pos
    return best


def _embed_fingerprint() -> str:
    """embedding 模型的**稳定标识**：本地目录只取目录名（bge-large-en-v1.5）。

    直接拿 EMBED_MODEL 入 key 有个坑：`export EMBED_MODEL=/root/.../bge-large-en-v1.5`
    和"不设（默认 BAAI/bge-large-en-v1.5）"其实是**同一个模型**，但字符串不同 →
    同一个语料会算出两个缓存 key → 抽取缓存全失效、白抽一遍。取 basename 后
    两种情况都是 "bge-large-en-v1.5"，跨机器/跨路径也稳定。
    """
    name = os.path.basename(str(EMBED_MODEL).rstrip("/\\"))
    return name or str(EMBED_MODEL)


def _cache_key(question: str, contexts: list[dict]) -> str:
    h = hashlib.sha1()
    h.update(EXTRACT_SYSTEM.encode("utf-8"))  # 抽取 prompt 变了自动失效缓存
    h.update(_embed_fingerprint().encode("utf-8"))  # embedding 变了也自动失效缓存
    h.update(CHAT_MODEL.encode("utf-8"))      # 换抽取 LLM 也自动失效缓存（避免复用旧模型抽的图）
    h.update(EXTRACT_VERSION.encode("utf-8"))  # 建图管线版本号：合并/关联逻辑变更后自动失效旧缓存
    h.update(f"{EXTRACT_CHUNK_TOKENS}|{EXTRACT_CHUNK_OVERLAP}".encode("utf-8"))  # 切块参数进 key
    h.update(question.encode("utf-8"))
    for c in contexts:
        h.update(c.get("title", "").encode("utf-8"))
        h.update(c.get("text", "").encode("utf-8"))
    return h.hexdigest()[:16]


def build_graph_for_question(question: str, contexts: list[dict], use_cache: bool = True):
    """返回 (entities, hyperedges, chunks, hvecs)。默认按题缓存并复用。"""
    key = _cache_key(question, contexts)
    cdir = CACHE_DIR / key
    if use_cache and (cdir / "hvecs.npy").exists():
        entities = json.loads((cdir / "entities.json").read_text(encoding="utf-8"))
        hyperedges = json.loads((cdir / "hyperedges.json").read_text(encoding="utf-8"))
        chunks = json.loads((cdir / "chunks.json").read_text(encoding="utf-8"))
        hvecs = np.load(str(cdir / "hvecs.npy"))
        return entities, hyperedges, chunks, hvecs

    entity_registry: dict[str, dict] = {}
    alias_index: dict[str, str] = {}
    all_hyperedges: list[dict] = []
    chunk_records: list[dict] = []

    # ── 1. 建 sentence chunk + 切窗任务（chunk 带 qid，语料级下不同题的句子不撞 id）──
    # 窗口按 token 切（embedding 模型同一 tokenizer，400 token/40 重叠，与所有方法同口径）
    CHUNK, OVERLAP = EXTRACT_CHUNK_TOKENS, EXTRACT_CHUNK_OVERLAP
    tasks = []
    for ctx in contexts:
        title = ctx.get("title", "")
        qid = str(ctx.get("qid", ""))
        sents = ctx.get("sentences") or split_sentences(ctx.get("text", ""))
        if not sents:
            continue
        sent_records = []
        for si, sent in enumerate(sents):
            sc = {
                "id": make_id("C", f"{qid}|{title}|{si}|{sent[:60]}"),
                "title": title, "sent_idx": si, "text": sent,
                "entity_ids": [], "hyperedge_ids": [],
            }
            sent_records.append(sc)
            chunk_records.append(sc)
        full_text = " ".join(sc["text"] for sc in sent_records)
        # 每句在 full_text 中的字符区间，供切块后找相交句子
        spans = []
        pos = 0
        for sc in sent_records:
            spans.append((pos, pos + len(sc["text"])))
            pos += len(sc["text"]) + 1
        for slice_text, cs, ce in split_by_tokens(full_text, CHUNK, OVERLAP):
            idxs = [i for i, (s0, s1) in enumerate(spans) if s1 > cs and s0 < ce]
            if slice_text.strip() and idxs:
                tasks.append((title, slice_text, idxs, sent_records))

    # ── 2. 并发抽取（LLM 调用并发，结果顺序处理，对齐 hotpotqa） ──
    def extract_one(title, text):
        user = f"Title: {title}\n\nText:\n{text}"
        # phase 是**线程本地**的：调用方（test_layer/run.py）的 phase("build") 只作用于
        # 主线程，抽取跑在线程池里，不在这里各设一次的话，_cur_phase() 会回退成 "query"
        # → 建图的抽取 token 全被记进 query 桶，build/query 分桶就错了。
        with phase("build"):
            try:
                return llm_chat(EXTRACT_SYSTEM, user, json_mode=True, timeout=180)
            except Exception:
                return None

    # 增量断点：每 20 窗保存一次成功结果；中断重跑只补没完成/失败的窗口。
    # 只存非 None 结果（失败的下次重试）；最终缓存写完后删掉 checkpoint。
    ckpt_file = cdir / "checkpoint.json"
    results_map = {}
    if ckpt_file.exists():
        try:
            results_map = {int(k): v for k, v in
                           json.loads(ckpt_file.read_text(encoding="utf-8")).items()}
            print(f"  恢复抽取进度：已完成 {len(results_map)}/{len(tasks)} 窗口", flush=True)
        except Exception:
            results_map = {}

    pending_tasks = [(i, t) for i, t in enumerate(tasks) if i not in results_map]
    done = len(results_map)
    _bar_len = 0
    if pending_tasks:
        with ThreadPoolExecutor(max_workers=EXTRACT_WORKERS) as executor:
            futures = {executor.submit(extract_one, t[0], t[1]): i for i, t in pending_tasks}
            for f in as_completed(futures):
                i = futures[f]
                try:
                    results_map[i] = f.result()
                except Exception:
                    results_map[i] = None
                done += 1
                if done % 20 == 0 or done == len(tasks):
                    # 单行进度条（\r 覆盖），不再逐行刷屏
                    line = f"  抽取 {done}/{len(tasks)} 窗口"
                    sys.stderr.write("\r" + line + " " * max(0, _bar_len - len(line)))
                    sys.stderr.flush()
                    _bar_len = len(line)
                    good = {str(k): v for k, v in results_map.items() if v}
                    cdir.mkdir(parents=True, exist_ok=True)
                    ckpt_file.write_text(json.dumps(good, ensure_ascii=False),
                                         encoding="utf-8")
        if _bar_len:
            sys.stderr.write("\n")
            sys.stderr.flush()

    for i, (title, slice_text, idxs, sent_records) in enumerate(tasks):
        extracted = results_map.get(i)
        if not extracted:
            continue
        local_to_global: dict[str, str] = {}
        chunk_eids: list[str] = []          # 本窗涉及实体的 gid（用于窗口内 sentence 关联）
        gid_entities: dict[str, dict] = {}  # gid -> registry 实体（含别名，关联时用）

        for ent in extracted.get("entities", []):
            if not isinstance(ent, dict):
                continue
            name = str(ent.get("name", "")).strip()
            if not name:
                continue
            key = norm(name)
            if key in entity_registry:
                target = key
            elif key in alias_index:
                target = alias_index[key]
            else:
                target = None
                for a in ent.get("aliases", []):
                    ak = norm(a)
                    if ak in alias_index:
                        target = alias_index[ak]
                        break
                if target is None:
                    target = key
            if target not in entity_registry:
                entity_registry[target] = {
                    "id": make_id("E", target), "name": name,
                    "aliases": [a.strip() for a in ent.get("aliases", []) if a.strip() and a.strip() != name],
                    "type": ent.get("type", ""), "description": ent.get("description", ""),
                    "time_span": ent.get("time_span", ""),
                    "region_names": [r.strip() for r in ent.get("region_names", []) if r.strip()] if isinstance(ent.get("region_names"), list) else [],
                }
                alias_index.setdefault(key, target)
                for a in ent.get("aliases", []):
                    alias_index.setdefault(norm(a), target)
            else:
                ex = entity_registry[target]
                if norm(ex["name"]) != key and name not in ex["aliases"]:
                    ex["aliases"].append(name)
                for a in ent.get("aliases", []):
                    a = a.strip()
                    if a and a != name and a not in ex["aliases"]:
                        ex["aliases"].append(a)
                alias_index.setdefault(key, target)
                # 对齐 hotpotqa：保留更长 description、补 type/time_span、合并 region_names
                if len(ent.get("description", "")) > len(ex.get("description", "")):
                    ex["description"] = ent["description"]
                if not ex.get("type") and ent.get("type"):
                    ex["type"] = ent["type"]
                if not ex.get("time_span") and ent.get("time_span"):
                    ex["time_span"] = ent["time_span"]
                new_regions = ent.get("region_names", [])
                if isinstance(new_regions, list):
                    for r in new_regions:
                        r = r.strip()
                        if r and r not in ex.get("region_names", []):
                            ex.setdefault("region_names", []).append(r)
            lid = str(ent.get("local_id", "")).strip()
            if lid:
                gid = entity_registry[target]["id"]
                local_to_global[lid] = gid
                if gid not in chunk_eids:
                    chunk_eids.append(gid)
                    gid_entities[gid] = entity_registry[target]

        chunk_he_ids: list[str] = []
        he_by_id: dict[str, dict] = {}
        for he in extracted.get("hyperedges", []):
            if not isinstance(he, dict):
                continue
            summary = str(he.get("summary", "")).strip()
            if not summary:
                continue
            eids, enames = [], []
            for lid in he.get("entity_ids", []):
                gid = local_to_global.get(str(lid).strip())
                if gid and gid not in eids:
                    eids.append(gid)
                    # 用 id 反查实体名（entity_registry 的 key 是"归一化名"，不是 id）
                    ent_obj = gid_entities.get(gid)
                    if ent_obj is None:
                        for _e in entity_registry.values():
                            if _e["id"] == gid:
                                ent_obj = _e
                                break
                    enames.append(ent_obj["name"] if ent_obj else gid)
            if not eids:
                continue
            head_lid = str(he.get("head_entity", "")).strip()
            head = local_to_global.get(head_lid)
            hid = make_id("H", summary + "|" + "|".join(sorted(eids)))
            he_rec = {
                "id": hid, "summary": summary,
                "entity_ids": eids, "entity_names": enames,
                "head_entity": head,
                "time_span": _coerce_str(he.get("time_span", "")),
                "region_names": [r.strip() for r in he.get("region_names", []) if r.strip()] if isinstance(he.get("region_names"), list) else [],
                "window_text": slice_text,  # small-to-big：生成时映射回原文窗口
            }
            all_hyperedges.append(he_rec)
            chunk_he_ids.append(hid)
            he_by_id[hid] = he_rec

        # 窗口内关联 sentence（实体名/别名关键词重叠，对齐 hotpotqa：
        # 只在抽取窗口范围内关联，避免语料级下 O(H×C) 全量扫描和跨题污染）
        for si in idxs:
            sc = sent_records[si]
            sent_lower = sc["text"].lower()
            for eid in chunk_eids:
                e = gid_entities[eid]
                matched = e["name"].lower() in sent_lower
                if not matched:
                    for alias in e.get("aliases", []):
                        if alias.lower() in sent_lower:
                            matched = True
                            break
                if matched and eid not in sc["entity_ids"]:
                    sc["entity_ids"].append(eid)
            for hid in chunk_he_ids:
                he_rec = he_by_id[hid]
                matched = False
                for ename in he_rec.get("entity_names", []):
                    if ename.lower() in sent_lower:
                        matched = True
                        break
                if not matched:
                    for eid in he_rec.get("entity_ids", []):
                        e = gid_entities.get(eid)
                        if e:
                            for alias in e.get("aliases", []):
                                if alias.lower() in sent_lower:
                                    matched = True
                                    break
                            if matched:
                                break
                if matched and hid not in sc["hyperedge_ids"]:
                    sc["hyperedge_ids"].append(hid)

    # ── 3. 超边去重 + head 回填（sentence 关联已在窗口内完成）──
    seen = {}
    for he in all_hyperedges:
        k = he["summary"]
        if k not in seen:
            seen[k] = he
        else:
            ex = seen[k]
            ex["entity_ids"] = sorted(set(ex["entity_ids"]) | set(he["entity_ids"]))
            ex["entity_names"] = sorted(set(ex["entity_names"]) | set(he["entity_names"]))
            if not ex.get("head_entity"):
                ex["head_entity"] = he.get("head_entity")
            if not ex.get("time_span"):
                ex["time_span"] = he.get("time_span", "")
            for r in he.get("region_names", []):
                if r not in ex.get("region_names", []):
                    ex.setdefault("region_names", []).append(r)
    hyperedges = list(seen.values())
    entities_by_id = {e["id"]: e for e in entity_registry.values()}

    for he in hyperedges:
        if not he.get("head_entity") or he["head_entity"] not in entities_by_id:
            he["head_entity"] = _infer_head(he, entities_by_id, None)

    entities = sorted(entity_registry.values(), key=lambda e: e["id"])
    htexts = [h["summary"] for h in hyperedges]
    hvecs = embed_batch(htexts) if htexts else np.zeros((0, 1024))

    # ── 存盘缓存，下次直接复用 ──
    if not hyperedges:
        # 抽取全失败（多半是 LLM 服务挂了）：不能把空图写进缓存，
        # 否则下次会"命中"这个垃圾缓存，出现删了缓存却还在用缓存的假象
        print(f"[WARN] 抽取 0 超边（LLM 服务不可用？），不写缓存", flush=True)
        return entities, hyperedges, chunk_records, hvecs
    cdir.mkdir(parents=True, exist_ok=True)
    (cdir / "entities.json").write_text(json.dumps(entities, ensure_ascii=False, indent=2), encoding="utf-8")
    (cdir / "hyperedges.json").write_text(json.dumps(hyperedges, ensure_ascii=False, indent=2), encoding="utf-8")
    (cdir / "chunks.json").write_text(json.dumps(chunk_records, ensure_ascii=False, indent=2), encoding="utf-8")
    np.save(str(cdir / "hvecs.npy"), hvecs.astype(np.float32))
    ckpt_file.unlink(missing_ok=True)  # 完整缓存已写，checkpoint 使命完成
    return entities, hyperedges, chunk_records, hvecs
